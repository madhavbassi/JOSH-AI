# Required for live chat responses.
GROQ_API_KEY=replace-with-your-groq-api-key

# Optional. The web application serves chat and the resume on the same origin.
# Set this only when serving the API from a different origin.
CORS_ORIGINS=https://your-frontend.example.com

# Optional voice greeting endpoint. The browser feature is disabled by default.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
GROQ_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=all-MiniLM-L6-v2
